{
  "name": "paybound",
  "version": "0.1.0",
  "description": "Paybound: let AI agents pay on BNB Smart Chain only what a person approved. A signed approval (recipient, ceiling, uses, expiry) is enforced by a vault; every refusal is recorded on chain. Testnet only, not audited.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "paybound": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "viem": "^2.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "agent-payments",
    "ai-agent",
    "ai-agents",
    "aqta",
    "bnb",
    "bnb-chain",
    "bsc",
    "eip-712",
    "paybound",
    "payments",
    "seal",
    "smart-contract",
    "spending-limits",
    "viem",
    "ai-security",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aqta-ai/paybound.git",
    "directory": "packages/paybound"
  },
  "homepage": "https://paybound-eight.vercel.app",
  "bugs": {
    "url": "https://github.com/Aqta-ai/paybound/issues"
  },
  "author": "Aqta Technologies Limited (https://aqta.ai)"
}
