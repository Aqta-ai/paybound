{
  "name": "@aqta/spend-guard",
  "version": "0.1.0",
  "description": "Let AI agents pay on BNB Smart Chain without giving them unlimited authority. A person approves one exact payment; the vault pays only that, and records every refusal on chain.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "spend-guard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "viem": "^2.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "bnb",
    "bsc",
    "bnb-chain",
    "ai-agent",
    "agent-payments",
    "spending-limits",
    "smart-contract",
    "viem",
    "seal",
    "aqta"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aqta-ai/seal-spend-guard.git",
    "directory": "packages/spend-guard"
  },
  "homepage": "https://aqta.ai/seal"
}