# Copy to .env (untracked). Testnet only. Never put a mainnet or funded personal key here.
# `npm run new-deployer` fills DEPLOYER_PRIVATE_KEY for you without printing it.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=

# Optional roles for deploy.ts (addresses only)
GUARDIAN_ADDRESS=
APPROVER_ADDRESSES=
REQUIRED_APPROVALS=1
TIMELOCK_SECONDS=3600
AGENT_ADDRESS=

# CLI
RPC_URL=http://127.0.0.1:8545
APPROVER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Demo page in bsc-testnet mode (npm run stage -- --network bsc-testnet) also uses
# DEPLOYER_PRIVATE_KEY as the vault owner, APPROVER_PRIVATE_KEY, AGENT_PRIVATE_KEY and,
# if set, a separate guardian key. Testnet keys only.
GUARDIAN_PRIVATE_KEY=

# Optional real model for the example agent: any OpenAI-compatible endpoint, e.g. a local Ollama.
AGENT_MODEL_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_KEY=
# Optional: what the header shows, e.g. "Qwen2.5 3B, running on this laptop"
AGENT_MODEL_LABEL=
# Local example (Ollama): AGENT_MODEL_URL=http://localhost:11434/v1  AGENT_MODEL_NAME=qwen2.5:3b

# Optional server-side market checks for the synthetic tUSD payment.
# With only CMC_API_KEY set, the agent checks the reference coin on CoinMarketCap.
# Set ATLAS_BSC_RPC_URL to https://bsc-rpc.publicnode.com to require BOTH live
# USDT/USD quotes. Missing credentials or an unavailable source holds the payment.
# Atlas reads public data on chain 56. Payment clients still use local or BSC testnet.
CMC_API_KEY=
ATLAS_BSC_RPC_URL=
